# Optional overrides — mspbots-rmm-mcp has no required env vars.
# Authentication is per-request via three headers (provided by the MCP caller):
#   X-MSP-Token       RMM Control API access credential (JWT bearer token,
#                     already issued to the caller). Forwarded verbatim as
#                     "Authorization: Bearer <token>" to the RMM Control API.
#   X-MSP-Tenant-Id   Tenant identifier. Forwarded to the downstream API as
#                     an "X_Tenant_ID" header (kept consistent with the
#                     platform convention). The tenant is also embedded in
#                     the JWT itself.
#   X-MSP-Host        Base host for the RMM Control API, e.g.
#                     https://agent.mspbots.ai — this server appends
#                     "/apps/mb-platform-rmm/api/rmm/<endpoint>" to it.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
